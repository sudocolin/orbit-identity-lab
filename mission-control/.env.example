# Copy to .env (git-ignored) with:  python make_secrets.py
# Values from the Mission Control app registration in Entra:
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Your Tailscale Funnel URL, no trailing slash:
PUBLIC_BASE_URL=https://your-pc.your-tailnet.ts.net
# Generated by make_secrets.py. Paste SCIM_TOKEN into Entra > Provisioning > Secret Token.
SCIM_TOKEN=
SESSION_SECRET=
# How often each session is re-checked with Entra (seconds). Low for the demo.
REVALIDATE_SECONDS=60
# How often an agent's status is re-read from Entra ID (seconds).
AGENT_STATUS_SECONDS=15

# Used by agents/orbit_agent.py (optional):
# MC_API_BASE=http://127.0.0.1:8000
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
